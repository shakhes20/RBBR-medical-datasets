# Raw downloaded/uploaded datasets (large, redistributable per original license only)
data/raw/*.csv
data/raw/*.zip
data/raw/*.data

# Processed intermediate R objects (regenerable via scripts/01-03)
data/processed/*.rds

# R session/history files
.Rhistory
.RData
.Rproj.user/

# OS files
.DS_Store
Thumbs.db

# Keep folder structure via .gitkeep even though contents are ignored
!data/raw/.gitkeep
!data/processed/.gitkeep
